{
  "crons": [
    {
      "path": "/api/sms/dispatch",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/sms/campaign-dispatch",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/seya/relance",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/billing/renewals",
      "schedule": "0 7 * * *"
    }
  ],
  "functions": {
    "api/health/repair-seya.js": {
      "maxDuration": 60
    },
    "api/seya/whatsapp.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/r/:token",
      "destination": "/r"
    },
    {
      "source": "/centres/:slug",
      "destination": "/centres"
    }
  ]
}
